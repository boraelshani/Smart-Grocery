
# =========================
# Python / Flask .gitignore
# =========================

# Virtual environments
.venv/
venv/
env/
ENV/

# Python helpers
.python-version
pip-log.txt
pip-delete-this-directory.txt

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc
*.pyo
*.pyd

# Distribution / packaging
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# JetBrains project files
.idea/**

# OS files
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# Environment / secrets
.env
.env.local
.env.*.local
.envrc

# Flask
instance/
.webassets-cache
gunicorn.sock

# Database files
*.db
*.sqlite
*.sqlite3

# MongoDB dumps
dump/
*.bson
*.gz

# Logs
*.log

# Testing / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Caches
.mypy_cache/
.cache/
pip-wheel-metadata/

# Jupyter
.ipynb_checkpoints/

# Node / frontend
node_modules/
# You can keep package-lock.json / yarn.lock if desired

# Temporary files
*.bak
*.tmp

# Generated scraper/debug artifacts
logs/*.json
*_out.txt
nuxt_dump.json
output.txt
billa_tree.json
compare_page.html
hofer.png
hofer_home.png

# Playwright / Chromium browser profile and generated scraper artifacts
data/spar_profile/
data/spar_storage_state.json
# HAR files (HTTP Archive) used for debugging/snapshots
*.har
www.spar.at.har


